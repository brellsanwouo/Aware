# --- Runtime defaults ---
PARSER_MAX_ATTEMPTS=5
AWARE_PARSER_KB_FILE=knowledge/parser_buildspec_kb.md
AWARE_EXECUTOR_V3_KB_FILE=knowledge/executor_rca_v3_kb.md
EXECUTOR_MAX_AGENTS=5
EXECUTOR_MAX_EXPANSIONS=2
AWARE_ENABLE_REASONING=true
AWARE_ENABLE_MEMORY=true

# --- OpenAI provider ---
# AWARE_LLM_PROVIDER=openai-compatible
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# --- Ollama Cloud alternative (uncomment and set your own key/model) ---
# AWARE_LLM_PROVIDER=ollama
# OLLAMA_API_KEY=your_ollama_cloud_api_key
# OLLAMA_MODEL=gemma4:31b
# OLLAMA_BASE_URL=https://ollama.com/v1
# OLLAMA_TIMEOUT_SECONDS=120

# --- UI defaults ---
UI_HOST=127.0.0.1
UI_PORT=8787
UI_DEFAULT_SOURCE_PATH=
